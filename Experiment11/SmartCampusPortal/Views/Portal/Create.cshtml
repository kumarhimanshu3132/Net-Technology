@model SmartCampusPortal.Models.CampusServiceTicket
@{
    ViewData["Title"] = "Raise Service Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h3 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Raise Campus Service Request
                </h3>
                <p class="text-muted small mb-0">
                    Submit a campus issue to the central maintenance repository via MVC &amp; REST API.
                </p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i> New Ticket Entry Form
                </span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="createTicketForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <!-- Student Name -->
                        <div class="col-md-6">
                            <label asp-for="StudentName" class="form-label fw-semibold">
                                Student Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="StudentName" class="form-control" placeholder="e.g., Aarav Sharma" />
                            </div>
                            <span asp-validation-for="StudentName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Room / Block -->
                        <div class="col-md-6">
                            <label asp-for="RoomOrBlock" class="form-label fw-semibold">
                                Room / Block / Lab Location <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="RoomOrBlock" class="form-control" placeholder="e.g., Hostel Block A - 204 or Lab 3" />
                            </div>
                            <span asp-validation-for="RoomOrBlock" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Service Category -->
                        <div class="col-md-6">
                            <label asp-for="ServiceCategory" class="form-label fw-semibold">
                                Service Category <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                <select asp-for="ServiceCategory" class="form-select">
                                    <option value="">-- Select Category --</option>
                                    <option value="Wi-Fi">Wi-Fi &amp; Internet</option>
                                    <option value="Hostel Maintenance">Hostel Maintenance</option>
                                    <option value="Lab Issue">Lab Hardware / Software</option>
                                    <option value="ID Card">Smart RFID ID Card</option>
                                    <option value="Library">Central Library</option>
                                    <option value="Classroom">Classroom &amp; Projector</option>
                                    <option value="Other">Other Campus Facility</option>
                                </select>
                            </div>
                            <span asp-validation-for="ServiceCategory" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Priority -->
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">
                                Priority Level <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-flag"></i></span>
                                <select asp-for="Priority" class="form-select">
                                    <option value="Low">Low (Informational / Minor)</option>
                                    <option value="Medium" selected>Medium (Standard Turnaround)</option>
                                    <option value="High">High (Urgent / Impairing Academics)</option>
                                </select>
                            </div>
                            <span asp-validation-for="Priority" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Description" class="form-label fw-semibold mb-1">
                                    Issue Description <span class="text-danger">*</span>
                                </label>
                                <span class="text-muted small" id="charCounter">0 / 250 characters</span>
                            </div>
                            <textarea asp-for="Description" class="form-control" rows="4" maxlength="250" id="descTextarea"
                                      placeholder="Briefly describe the campus issue (max 250 characters)..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-send-check-fill me-1"></i> Submit Request
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light border-top py-2 px-4 text-muted small">
                <i class="bi bi-info-circle me-1 text-primary"></i> Submitting this form sends an HTTP POST request to <code>/api/campus</code>, which records the ticket into SQL Server database <code>B2026</code>.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const descArea = document.getElementById('descTextarea');
        const charCounter = document.getElementById('charCounter');
        if (descArea && charCounter) {
            const updateCount = () => {
                charCounter.textContent = `${descArea.value.length} / 250 characters`;
            };
            descArea.addEventListener('input', updateCount);
            updateCount();
        }
    </script>
}
