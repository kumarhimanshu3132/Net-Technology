@model PlacementDashboard.Models.CompanyReportViewModel
@{
    ViewData["Title"] = "Placement Summary Report";
}
<div class="container-fluid px-0 report-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2 no-print">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Placement Summary Report
            </h2>
            <p class="text-muted mb-0">Company-wise aggregation and campus placement statistics</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <button onclick="window.print()" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-printer-fill"></i> Print / Save as PDF
            </button>
        </div>
    </div>
    <!-- Official Report Document Header for Print / View -->
    <div class="card border-0 shadow-sm report-card mb-4">
        <div class="card-body p-4">
            <div
                class="border-bottom pb-3 mb-4 text-center text-sm-start d-sm-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-primary mb-1">
                        <i class="bi bi-mortarboard-fill me-2"></i>Campus Placement Cell
                    </h3>
                    <div class="text-muted">Department of Computer Engineering &amp; Technology</div>
                    <div class="small text-muted">Academic Batch 2022 - 2026 | Experiment 9 Data Analytics</div>
                </div>
                <div class="mt-3 mt-sm-0 text-sm-end">
                    <span class="badge bg-light text-dark border p-2">
                        <i class="bi bi-calendar3 me-1"></i>Report Date: @Model.GeneratedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </span>
                </div>
            </div>
            <!-- Highlights in Report -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center border">
                        <div class="text-uppercase small text-muted fw-semibold">Total Students</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.OverallSummary.TotalStudents</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center border">
                        <div class="text-uppercase small text-muted fw-semibold">Total Placed</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.OverallSummary.PlacedCount
                            (@Model.OverallSummary.PlacementRate%)</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded text-center border">
                            <div class="text-uppercase small text-muted fw-semibold">Max Package</div>
                            <div class="fs-4 fw-bold text-warning-emphasis mt-1">
                                ₹@Model.OverallSummary.HighestPackage.ToString("N2") LPA</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded text-center border">
                                <div class="text-uppercase small text-muted fw-semibold">Avg Package</div>
                                <div class="fs-4 fw-bold text-info-emphasis mt-1">
                                    ₹@Model.OverallSummary.AveragePackage.ToString("N2") LPA</div>
                                </div>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-buildings text-secondary"></i>Company-wise Placement Summary
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped align-middle report-table mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" style="width: 50px;" class="text-center">#</th>
                                        <th scope="col">Company Name</th>
                                        <th scope="col">Roles Offered</th>
                                        <th scope="col" class="text-center">Candidates</th>
                                        <th scope="col" class="text-center text-success-emphasis">Placed</th>
                                        <th scope="col" class="text-center">Pending</th>
                                        <th scope="col" class="text-center">Rejected</th>
                                        <th scope="col" class="text-end">Max Offer</th>
                                        <th scope="col" class="text-end">Avg Offer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CompanySummaries.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center py-4 text-muted">No placement records available for
                                                report generation.</td>
                                            </tr>
                                        }
                        else
                                        {
                                            int count = 1;
                                            foreach (var comp in Model.CompanySummaries)
                                            {
                                                <tr>
                                                    <td class="text-center fw-semibold text-muted">@count</td>
                                                    <td>
                                                        <span class="fw-bold text-dark">@comp.CompanyName</span>
                                                    </td>
                                                    <td>
                                                        <span class="small text-muted">@comp.RolesOffered</span>
                                                    </td>
                                                    <td class="text-center fw-semibold">@comp.TotalCandidates</td>
                                                    <td class="text-center">
                                                        <span
                                                        class="badge bg-success-subtle text-success border border-success fw-bold">@comp.PlacedCount</span>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (comp.PendingCount > 0)
                                                        {
                                                            <span
                                                            class="badge bg-warning-subtle text-warning-emphasis border border-warning">@comp.PendingCount</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">0</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (comp.RejectedCount > 0)
                                                        {
                                                            <span
                                                            class="badge bg-danger-subtle text-danger border border-danger">@comp.RejectedCount</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">0</span>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-semibold text-dark">₹@comp.HighestPackage.ToString("N2") LPA</td>
                                                    <td class="text-end fw-semibold text-primary">₹@comp.AveragePackage.ToString("N2") LPA</td>
                                                </tr>
                                                count++;
                                            }
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="3" class="text-end">Grand Total / Overall:</td>
                                            <td class="text-center">@Model.OverallSummary.TotalStudents</td>
                                            <td class="text-center text-success">@Model.OverallSummary.PlacedCount</td>
                                            <td class="text-center text-warning-emphasis">@Model.OverallSummary.PendingCount</td>
                                            <td class="text-center text-danger">@Model.OverallSummary.RejectedCount</td>
                                            <td class="text-end text-dark">₹@Model.OverallSummary.HighestPackage.ToString("N2") LPA</td>
                                            <td class="text-end text-primary">₹@Model.OverallSummary.AveragePackage.ToString("N2") LPA
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="mt-4 pt-3 border-top text-muted small d-flex justify-content-between">
                                <span>Verified by Placement Officer: ___________________</span>
                                <span>Head of Department: ___________________</span>
                            </div>
                        </div>
                    </div>
                </div>