@model PlacementDashboard.Models.Placement
@{
    ViewData["Title"] = "Edit Placement";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-dark text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square fs-5"></i>
                    <h5 class="card-title mb-0 fw-bold">Edit Placement Record</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    <input type="hidden" asp-for="PlacementId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="StudentName" class="form-label fw-semibold"></label>
                        <input asp-for="StudentName" class="form-control" placeholder="Enter Your Name" />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EnrollmentNo" class="form-label fw-semibold"></label>
                        <input asp-for="EnrollmentNo" class="form-control" placeholder="Enter Your Enrollment Number" />
                        <span asp-validation-for="EnrollmentNo" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Enter Company Name" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Role" class="form-label fw-semibold"></label>
                            <input asp-for="Role" class="form-control" placeholder="Enter Role / Designation" />
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-2 mb-4">
                        <div class="col-12 col-sm-6">
                            <label asp-for="PackageLPA" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="PackageLPA" type="number" step="0.01" class="form-control"
                                       placeholder="Enter Package in LPA" />
                                <span class="input-group-text">LPA</span>
                            </div>
                            <span asp-validation-for="PackageLPA" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Placed">Placed</option>
                                <option value="Pending">Pending</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm px-4">
                            <i class="bi bi-check-lg"></i> Update Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}