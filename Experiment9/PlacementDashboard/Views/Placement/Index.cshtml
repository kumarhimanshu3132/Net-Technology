@model PlacementDashboard.Models.PlacementDashboardViewModel
@{
    ViewData["Title"] = "Placement Dashboard";

    string NextSortOrder(string column)
    {
        if (string.Equals(Model.SortBy, column, StringComparison.OrdinalIgnoreCase))
        {
            return string.Equals(Model.SortOrder, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
        }
        return "asc";
    }

    string SortIcon(string column)
    {
        if (string.Equals(Model.SortBy, column, StringComparison.OrdinalIgnoreCase))
        {
            return string.Equals(Model.SortOrder, "desc", StringComparison.OrdinalIgnoreCase)
                ? "<i class=\"bi bi-arrow-down-short text-primary\"></i>"
                : "<i class=\"bi bi-arrow-up-short text-primary\"></i>";
        }
        return "<i class=\"bi bi-arrow-down-up text-muted opacity-50\"></i>";
    }
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Campus Placement Dashboard
            </h2>
            <p class="text-muted mb-0">Experiment 9: Interactive Placement Analytics &amp; Data Grid Control</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add New Placement</span>
            </a>
            <a asp-action="Report" class="btn btn-outline-dark d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Placement Report</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm kpi-card kpi-primary">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small">Total Students</div>
                        <div class="fs-2 fw-bold text-dark mt-1">@Model.Summary.TotalStudents</div>
                        <div class="small text-muted mt-1">
                            <span class="badge bg-secondary-subtle text-secondary">Registered Candidates</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrapper bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm kpi-card kpi-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small">Placed Count</div>
                        <div class="fs-2 fw-bold text-success mt-1">@Model.Summary.PlacedCount</div>
                        <div class="small mt-1">
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-graph-up-arrow me-1"></i>@Model.Summary.PlacementRate% Placed
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrapper bg-success-subtle text-success">
                        <i class="bi bi-award-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm kpi-card kpi-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small">Highest Package</div>
                        <div class="fs-2 fw-bold text-warning-emphasis mt-1">₹@Model.Summary.HighestPackage.ToString("N2") <span class="fs-6 fw-normal text-muted">LPA</span></div>
                        <div class="small text-muted mt-1">
                            <span class="badge bg-warning-subtle text-warning-emphasis">Peak Campus Offer</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrapper bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-trophy-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm kpi-card kpi-info">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small">Average Package</div>
                        <div class="fs-2 fw-bold text-info-emphasis mt-1">₹@Model.Summary.AveragePackage.ToString("N2") <span class="fs-6 fw-normal text-muted">LPA</span></div>
                        <div class="small text-muted mt-1">
                            <span class="badge bg-info-subtle text-info-emphasis">Mean Placement Comp</span>
                        </div>
                    </div>
                    <div class="kpi-icon-wrapper bg-info-subtle text-info">
                        <i class="bi bi-calculator-fill fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid Filter & Controls Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />

                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" 
                               placeholder="Search by Student Name, Company, Enrollment Number, or Role..." 
                               value="@Model.SearchTerm" />
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-funnel text-muted"></i>
                        </span>
                        <select name="statusFilter" class="form-select">
                            @foreach (var opt in Model.StatusOptions)
                            {
                                if (string.Equals(Model.StatusFilter, opt, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@opt" selected="selected">Status: @opt</option>
                                }
                                else
                                {
                                    <option value="@opt">Status: @opt</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-filter"></i> Apply Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-1" title="Reset all filters">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Interactive Data Grid Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary"></i>
                <h5 class="mb-0 fw-bold">Student Placement Records</h5>
                <span class="badge bg-light text-dark border">@Model.Placements.Count record(s)</span>
            </div>
            <div class="text-muted small">
                Click column headers to sort
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 data-grid-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-3" style="width: 70px;">#</th>
                        <th scope="col">
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-statusFilter="@Model.StatusFilter" 
                               asp-route-sortBy="name" 
                               asp-route-sortOrder="@NextSortOrder("name")" 
                               class="text-decoration-none text-dark d-inline-flex align-items-center gap-1">
                                <span>Student Name</span>
                                @Html.Raw(SortIcon("name"))
                            </a>
                        </th>
                        <th scope="col">
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-statusFilter="@Model.StatusFilter" 
                               asp-route-sortBy="enrollment" 
                               asp-route-sortOrder="@NextSortOrder("enrollment")" 
                               class="text-decoration-none text-dark d-inline-flex align-items-center gap-1">
                                <span>Enrollment No</span>
                                @Html.Raw(SortIcon("enrollment"))
                            </a>
                        </th>
                        <th scope="col">
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-statusFilter="@Model.StatusFilter" 
                               asp-route-sortBy="company" 
                               asp-route-sortOrder="@NextSortOrder("company")" 
                               class="text-decoration-none text-dark d-inline-flex align-items-center gap-1">
                                <span>Company</span>
                                @Html.Raw(SortIcon("company"))
                            </a>
                        </th>
                        <th scope="col">Role / Designation</th>
                        <th scope="col" class="text-end">
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-statusFilter="@Model.StatusFilter" 
                               asp-route-sortBy="package" 
                               asp-route-sortOrder="@NextSortOrder("package")" 
                               class="text-decoration-none text-dark d-inline-flex align-items-center gap-1">
                                <span>Package (LPA)</span>
                                @Html.Raw(SortIcon("package"))
                            </a>
                        </th>
                        <th scope="col" class="text-center">
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-statusFilter="@Model.StatusFilter" 
                               asp-route-sortBy="status" 
                               asp-route-sortOrder="@NextSortOrder("status")" 
                               class="text-decoration-none text-dark d-inline-flex align-items-center gap-1">
                                <span>Status</span>
                                @Html.Raw(SortIcon("status"))
                            </a>
                        </th>
                        <th scope="col" class="text-center pe-3" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Placements.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <h6>No placement records found.</h6>
                                    <p class="small mb-3">Try adjusting your search criteria or filter, or add a new record.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-lg me-1"></i>Add Placement Record
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNum = 1;
                        foreach (var item in Model.Placements)
                        {
                            <tr>
                                <td class="ps-3 text-muted fw-semibold">@rowNum</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.StudentName</div>
                                </td>
                                <td>
                                    <code class="text-secondary fw-bold">@item.EnrollmentNo</code>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-building text-secondary"></i>
                                        <span class="fw-medium">@item.CompanyName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@item.Role</span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-dark">₹@(item.PackageLPA.HasValue ? item.PackageLPA.Value.ToString("N2") : "0.00")</span>
                                    <span class="small text-muted">LPA</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Status.Equals("Placed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Placed
                                        </span>
                                    }
                                    else if (item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Rejected
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.PlacementId" 
                                           class="btn btn-outline-primary" title="Edit Record">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PlacementId" 
                                           class="btn btn-outline-danger" title="Delete Record">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            rowNum++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
