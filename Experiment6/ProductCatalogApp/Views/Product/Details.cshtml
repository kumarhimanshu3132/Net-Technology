@model ProductCatalogApp.Models.Product
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Product Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-center">
            <div class="card shadow-sm border-0" style="width: 100%; max-width: 650px;">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0">@Model.Name</h5>
                    <span class="badge bg-info text-dark">ID: #@Model.Id</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <span class="text-muted d-block small">Brand</span>
                            <strong>@Model.Brand</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block small">Category</span>
                            <strong>@Model.Category</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block small">Price</span>
                            <h4 class="text-success mb-0 fw-bold">₹@Model.Price.ToString("N0")</h4>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block small">Stock Status</span>
                            <strong>@Model.Stock units available</strong>
                        </div>
                        <div class="col-12 mt-3 pt-3 border-top">
                            <span class="text-muted d-block small">Description</span>
                            <p class="mb-0 text-secondary">@Model.Description</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-3 pt-0">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Back to Catalog
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>