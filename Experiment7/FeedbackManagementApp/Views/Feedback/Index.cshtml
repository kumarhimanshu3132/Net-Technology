@model IEnumerable<FeedbackManagementApp.Models.Feedback>
@{
    ViewData["Title"] = "Feedback Overview";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">User Feedback Dashboard</h3>
        <p class="text-muted mb-0">Consolidated feedback rendered via ASP.NET Core MVC Partial Views</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-pencil-square me-1"></i> Submit New Feedback
    </a>
</div>
<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var feedbackItem in Model)
        {
            <partial name="_FeedbackCard" model="feedbackItem" />
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-4">No feedbacks recorded yet.</div>
        </div>
    }
</div>