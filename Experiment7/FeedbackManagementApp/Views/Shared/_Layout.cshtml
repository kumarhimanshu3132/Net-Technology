<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feedback Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Feedback" asp-action="Index">
                    <i class="bi bi-chat-square-quote-fill me-2 text-warning"></i>Feedback Portal
                </a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-white" asp-controller="Feedback" asp-action="Index">Dashboard</a>
                    <a class="btn btn-warning btn-sm ms-2 fw-semibold" asp-controller="Feedback" asp-action="Create">
                        <i class="bi bi-plus-circle me-1"></i>Give Feedback
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="bg-white border-top py-3 mt-auto text-center text-muted small">
        <div class="container">
            &copy; 2026 - .NET Core MVC Feedback Management Module | Academic Lab Portal
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>